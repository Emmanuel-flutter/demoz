# Bring your own key (BYOK) for media generation (video / audio).
# The brand EXTRACTION step does NOT need a key — the agent reads your media in-session.
# Copy this file to .env and fill it in. Never commit .env (.gitignore excludes it).

# Your media provider key. Needed only when you run gen:video / gen:audio.
# The bundled integration uses fal.ai — get a key at https://fal.ai/dashboard/keys.
FAL_KEY=

# Optional model overrides. Leave a variable blank to use the built-in default.
# A --model <slug> flag on a gen script overrides the matching variable below.

# Text-to-video model (gen:video). Default: bytedance/seedance-2.0/text-to-video
VIDEO_MODEL=

# Voiceover / text-to-speech model (gen:audio voiceover). Default: fal-ai/elevenlabs/tts/eleven-v3
AUDIO_TTS_MODEL=

# Music model (gen:audio music). Default: fal-ai/lyria2
AUDIO_MUSIC_MODEL=

# Sound-effects model (gen:audio sfx). Default: fal-ai/elevenlabs/sound-effects/v2
AUDIO_SFX_MODEL=
